# Recovery Compass — Backend Environment
# -----------------------------------------------------------
# Copy to .env and fill in real values before running.
# NEVER commit .env to version control.
# -----------------------------------------------------------

# ── Database ──────────────────────────────────────────────
# Use the Supabase Transaction Pooler URL (port 6543)
# or the Direct Connection URL (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# For Prisma migrations only (direct connection, not pooler)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Redis (for Bull queue) ────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
# DANGER: NEVER expose this to the browser
SUPABASE_SECRET_KEY="your-supabase-service-role-key"

# ── JWT (custom session tokens — separate from Supabase Auth) ─
JWT_ACCESS_SECRET="change-me-in-production-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-in-production-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:3001"

# ── Supabase Storage ──────────────────────────────────────
# Provider: supabase | local | s3
STORAGE_PROVIDER="supabase"
# Bucket name (create this in Supabase Dashboard → Storage)
SUPABASE_STORAGE_BUCKET="discharge-documents"

# ── AI — Google Gemini (PRIMARY) ──────────────────────────
# DANGER: NEVER expose this to the browser
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-pro"
GEMINI_MAX_TOKENS=8192
GEMINI_TIMEOUT_MS=60000

# ── AI — OpenAI (FALLBACK — optional) ────────────────────
# Leave blank if using Gemini only
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ── LLM Provider Selection ────────────────────────────────
# Options: gemini | openai
# Do NOT set to 'mock' in production
LLM_PROVIDER="gemini"

# ── RAG / Embeddings ──────────────────────────────────────
# Options: gemini | openai
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="text-embedding-004"
# Dimensions for Gemini text-embedding-004
EMBEDDING_DIMENSIONS=768
# Top-k chunks to retrieve per query
RAG_TOP_K=8

# ── OCR ───────────────────────────────────────────────────
# Options: tesseract | ocr-space | gemini-document
OCR_PROVIDER="tesseract"
# Required if OCR_PROVIDER=ocr-space
# OCR_SPACE_API_KEY="your-ocr-space-key"

# ── Email (optional) ──────────────────────────────────────
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@recoverycompass.app"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Recovery Compass <noreply@recoverycompass.app>"

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=10

# ── File Upload ───────────────────────────────────────────
MAX_FILE_SIZE_MB=20
ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png,image/jpg"
MAX_PAGES_PER_DOCUMENT=30

# ── Confidence Thresholds ─────────────────────────────────
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.60

# ── Invitation ────────────────────────────────────────────
INVITATION_EXPIRY_HOURS=48
OTP_EXPIRY_MINUTES=10

# ── Field Encryption ─────────────────────────────────────
# Must be exactly 32 characters
FIELD_ENCRYPTION_KEY="change-me-32-char-encryption-key!!"

# ── Demo Mode ─────────────────────────────────────────────
# ONLY set to true for hackathon demo with synthetic data
DEMO_MODE=false
DEMO_PATIENT_EMAIL="demo.patient@recoverycompass.app"

# ── Prototype Notice ──────────────────────────────────────
IS_PROTOTYPE=true
PROTOTYPE_NOTICE="This is a hackathon prototype. Not for clinical use. All data is synthetic."
